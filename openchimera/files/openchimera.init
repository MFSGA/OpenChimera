#!/bin/sh /etc/rc.common
# OpenChimera procd init service
# Milestone 1 - basic lifecycle placeholder
# Full implementation in Task 7

USE_PROCD=1

START=99
STOP=10

PROG=/usr/bin/mihomo
WORK_DIR=/etc/openchimera/run
CONFIG_FILE=config.yaml
LOG_FILE=/var/log/openchimera/core.log

start_service() {
	# Ensure log directory exists
	mkdir -p /var/log/openchimera

	[ -f "$WORK_DIR/$CONFIG_FILE" ] || {
		logger -t openchimera "config not found: $WORK_DIR/$CONFIG_FILE"
		return 1
	}

	procd_open_instance
	procd_set_param command "$PROG" -d "$WORK_DIR" -c "$CONFIG_FILE" --log-file "$LOG_FILE"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	:
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger "openchimera"
}
